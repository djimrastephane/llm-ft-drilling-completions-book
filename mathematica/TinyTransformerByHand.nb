Cell["\<\
Both checks come back True, computed \[LongDash] not assumed. P(\"shoe\") \
rose from \[TildeEqual] 0.201 to \[TildeEqual] 0.432, and the loss fell from \
\[TildeEqual] 1.604 to \[TildeEqual] 0.840. The predicted \
(highest-probability) token flips from \"run\" before training to \"shoe\" \
after \[LongDash] one gradient step was enough to change the model's top \
guess for this single example.\
\>", "Text",ExpressionUUID->"710f4a6e-09c5-41b2-96f8-a1c8ba8589f5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BarChart", "[", 
  RowBox[{"probabilitiesNew", ",", " ", 
   RowBox[{"ChartLabels", " ", "->", " ", "Vocabulary"}], ",", " ", 
   RowBox[{"ChartStyle", " ", "->", " ", "\"\<Pastel\>\""}], ",", "\n", "  ", 
   
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<P(next token | \\\"run casing\\\") \[LongDash] after training\>\
\""}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "420"}]}], "]"}]], "Input",
 CellLabel->"In[75]:=",ExpressionUUID->"0fbe6879-7ecd-4bf6-9945-ebe66810d965"],

