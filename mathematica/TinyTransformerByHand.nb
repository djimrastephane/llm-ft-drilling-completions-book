Cell["\<\
These are logits, not probabilities: they can be negative (cement, <EOS>), \
they do not sum to 1, and by themselves they only rank tokens relative to \
each other. \"shoe\" and \"run\" currently have the two largest logits, with \
\"shoe\" barely behind. The next section turns these into an actual \
probability distribution.\
\>", "Text",ExpressionUUID->"2bdfb607-cea4-4891-8e0b-fe1a385035db"]
}, Open  ]],

Cell[CellGroupData[{

Cell["10. Next-Token Probabilities", "Section",ExpressionUUID->"cbd46456-b814-4675-8645-9d696cd49024"],

Cell["\<\
We apply the same softmax formula from Section 7, this time to all 6 logits \
at once:\
\>", "Text",ExpressionUUID->"2055628e-8a33-4ff0-abfe-dc3f42ec955a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Softmax2", "[", "z_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"m", " ", "=", " ", 
        RowBox[{"Max", "[", "z", "]"}]}], ",", " ", "ex"}], "}"}], ",", " ", 
     RowBox[{
      RowBox[{"ex", " ", "=", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{"z", " ", "-", " ", "m"}], "]"}]}], ";", " ", 
      RowBox[{"ex", "/", 
       RowBox[{"Total", "[", "ex", "]"}]}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"probabilities", " ", "=", " ", 
   RowBox[{"Softmax2", "[", "logits", "]"}]}], ";"}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"Vocabulary", ",", " ", 
        RowBox[{"N", "[", 
         RowBox[{"logits", ",", " ", "4"}], "]"}], ",", " ", 
        RowBox[{"N", "[", 
         RowBox[{"probabilities", ",", " ", "4"}], "]"}]}], "}"}], "]"}], ",",
      "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<Token\>\"", ",", " ", "\"\<Logit\>\"", ",", 
       " ", "\"\<Probability\>\""}], "}"}]}], "]"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Background", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"None", ",", " ", 
      RowBox[{"{", 
       RowBox[{"LightGray", ",", " ", "None"}], "}"}]}], "}"}]}]}], 
  "]"}]}], "Input",
 CellLabel->"In[43]:=",ExpressionUUID->"516740b7-314f-413a-9e7b-be9273ffa1f8"],

