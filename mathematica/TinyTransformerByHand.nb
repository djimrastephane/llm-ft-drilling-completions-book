Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\"\<P(shoe) increased?\>\"", " ", "->", " ", 
    RowBox[{"pShoeNew", " ", ">", " ", "pShoe"}]}], ",", " ", 
