Cell["\<\
Column 4 shows the two largest-magnitude changes in the entire matrix (+2.070 \
and +0.528 relative to the old weights), both positive \[LongDash] a direct, \
visible consequence of \"shoe\" being the one column of dLogits that was \
negative.\
\>", "Text",ExpressionUUID->"9e12ce4b-3d22-4607-9288-8e8d177dca18"]
}, Open  ]],

Cell[CellGroupData[{

Cell["14. Run the Model Again", "Section",ExpressionUUID->"62fd91e2-d6ed-4f46-a280-69678bccf88f"],

Cell["\<\
Q, K, V, and the attention output h did not change (Section 12), so we can \
reuse h directly and only recompute the last two steps, Logits and Softmax, \
with the updated WOutNew:\
\>", "Text",ExpressionUUID->"99c49a7e-95f7-4988-85ad-f3057cc38620"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"logitsNew", " ", "=", " ", 
   RowBox[{"h", ".", "WOutNew"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"probabilitiesNew", " ", "=", " ", 
   RowBox[{"Softmax2", "[", "logitsNew", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"pShoeNew", " ", "=", " ", 
   RowBox[{"probabilitiesNew", "[", 
    RowBox[{"[", "targetIndex", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"lossNew", " ", "=", " ", 
   RowBox[{"-", 
    RowBox[{"Log", "[", "pShoeNew", "]"}]}]}], ";"}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"{", "\n", "   ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<\>\"", ",", " ", "\"\<Before training\>\"", ",", 
       " ", "\"\<After training\>\""}], "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<P(\\\"shoe\\\")\>\"", ",", " ", 
       RowBox[{"N", "[", 
        RowBox[{"pShoe", ",", " ", "4"}], "]"}], ",", " ", 
       RowBox[{"N", "[", 
        RowBox[{"pShoeNew", ",", " ", "4"}], "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<Loss\>\"", ",", " ", 
       RowBox[{"N", "[", 
        RowBox[{"loss", ",", " ", "4"}], "]"}], ",", " ", 
       RowBox[{"N", "[", 
        RowBox[{"lossNew", ",", " ", "4"}], "]"}]}], "}"}], ",", "\n", "   ", 
     
     RowBox[{"{", 
      RowBox[{"\"\<Predicted token\>\"", ",", " ", 
       RowBox[{"Vocabulary", "[", 
        RowBox[{"[", "predictedIndex", "]"}], "]"}], ",", "\n", "     ", 
       RowBox[{"Vocabulary", "[", 
        RowBox[{"[", 
         RowBox[{"First", "[", 
          RowBox[{"Ordering", "[", 
           RowBox[{"probabilitiesNew", ",", " ", 
            RowBox[{"-", "1"}]}], "]"}], "]"}], "]"}], "]"}]}], "}"}]}], "\n",
     "   ", "}"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Background", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"None", ",", " ", 
      RowBox[{"{", 
       RowBox[{"LightGray", ",", " ", "None", ",", " ", "None"}], "}"}]}], 
     "}"}]}], ",", "\n", "  ", 
   RowBox[{"Dividers", " ", "->", " ", "All"}]}], "]"}]}], "Input",
 CellLabel->"In[69]:=",ExpressionUUID->"1dd000f3-dcc8-4463-956a-a482020fd54b"],

