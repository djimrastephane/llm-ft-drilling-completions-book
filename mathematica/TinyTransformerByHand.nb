Cell[CellGroupData[{

Cell["Appendix B: Optional Cross-Check With a Built-In Function", "Section",ExpressionUUID->"db3e0674-43a3-43b1-b4ad-deec489e6bae"],

Cell["\<\
As a final, optional sanity check \[LongDash] and only as a cross-check, \
never as a replacement for the manual derivation above \[LongDash] we compare \
our hand-written softmax against Mathematica's built-in Softmax function \
applied to the same logits. This notebook does not use NetChain, NetGraph, \
NetTrain, Predict, or Classify anywhere; Softmax here is an ordinary numeric \
function, not a neural-network abstraction, and we use it only to confirm \
agreement with Sections 7 and 10, not to compute anything new.\
\>", "Text",ExpressionUUID->"af0102d8-3ddb-40a6-98a1-966c8f6360ed"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"builtInProbabilities", " ", "=", " ", 
   RowBox[{"Softmax", "[", "logits", "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\"\<our manual softmax\>\"", " ", "->", " ", 
    RowBox[{"N", "[", 
     RowBox[{"probabilities", ",", " ", "6"}], "]"}]}], ",", " ", 
   RowBox[{"\"\<built-in Softmax[]\>\"", " ", "->", " ", 
    RowBox[{"N", "[", 
     RowBox[{"builtInProbabilities", ",", " ", "6"}], "]"}]}], ",", "\n", 
   "  ", 
   RowBox[{"\"\<agree?\>\"", " ", "->", " ", 
    RowBox[{
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{"probabilities", " ", "-", " ", "builtInProbabilities"}], 
       "]"}], "]"}], " ", "<", " ", 
     RowBox[{"10", "^", 
      RowBox[{"-", "10"}]}]}]}]}], "}"}]}], "Input",
 CellLabel->"In[83]:=",ExpressionUUID->"2303a174-ed2f-4da5-9111-4a40b1cfae64"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"our manual softmax\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "0.1432678734957869`", ",", "0.2799126719101499`", ",", 
      "0.19932857023087475`", ",", "0.20118788401804047`", ",", 
      "0.0733288830260368`", ",", "0.10297411731911124`"}], "}"}]}], ",", 
   RowBox[{"\<\"built-in Softmax[]\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "0.1432678734957869`", ",", "0.2799126719101499`", ",", 
      "0.19932857023087475`", ",", "0.20118788401804047`", ",", 
      "0.0733288830260368`", ",", "0.10297411731911124`"}], "}"}]}], ",", 
   RowBox[{"\<\"agree?\"\>", "\[Rule]", "True"}]}], "}"}]], "Output",
 CellChangeTimes->{3.99674745456299*^9},
 CellLabel->"Out[84]=",ExpressionUUID->"f90ebbdf-e9b9-497f-9e01-832e2a29d9cc"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
