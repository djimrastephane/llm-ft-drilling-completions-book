Cell[CellGroupData[{

Cell["3. Outcome map: all questions at once", "Section",ExpressionUUID->"a62570d6-dfff-423b-9fd0-a40508769838"],

Cell["\<\
This compact map makes the pattern visible without clicking through examples \
one by one. Green means the answer exactly contained the reference wording. \
The word-overlap columns show how much of the correct answer's vocabulary \
appears in each model answer, which helps separate total misses from near \
misses.\
\>", "Text",ExpressionUUID->"f75e989b-e815-4c8d-a83d-f77bffd53bd7"],

Cell[CellGroupData[{

Cell["\<\
Grid[
  Prepend[
    Table[
      {
        Style[\"#\" <> ToString[i], GrayLevel[0.35]],
        Style[groupLabel[examplesList[[i]][\"group\"]], 11],
        \"Report #\" <> examplesList[[i]][\"report_number\"],
        questionIcon[examplesList[[i]][\"question_type\"]],
        statusCell[examplesList[[i]][\"base_matched\"]],
        statusCell[examplesList[[i]][\"finetuned_matched\"]],
        NumberForm[recallValue[examplesList[[i]], \"base\"], {3, 2}],
        NumberForm[recallValue[examplesList[[i]], \"finetuned\"], {3, 2}],
        Style[examplesList[[i]][\"failure_category\"], 10, GrayLevel[0.25]]
      },
      {i, Length[examplesList]}
    ],
    {Style[\"Row\", Bold], Style[\"Set\", Bold], Style[\"Report\", Bold], \
Style[\"Question\", Bold], Style[\"Before\", Bold], Style[\"After\", Bold], \
Style[\"Before word overlap\", Bold], Style[\"After word overlap\", Bold], \
Style[\"Reading\", Bold]}
  ],
  Alignment -> Left,
  Dividers -> {None, {True, True}},
  Spacings -> {1.2, .7},
  Background -> {None, {RGBColor[0.92, 0.92, 0.88], None}}
]\
\>", "Input",
 CellOpen->False,
 CellLabel->"In[38]:=",ExpressionUUID->"98717170-de84-4a62-9f0d-c27435851e58"],

